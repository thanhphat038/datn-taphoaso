{
  "name": "taphoaso-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for TapHoaSo",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "pm2 start server.js --name taphoaso-backend",
    "check-config": "node scripts/check-config.js",
    "predev": "npm run check-config",
    "prestart": "npm run check-config",
    "check-chroma": "node scripts/check-chroma-status.js",
    "sync-chroma": "node scripts/sync-products-to-chroma.js",
    "cleanup-chroma": "node scripts/cleanup-chroma.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "chromadb": "^1.10.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "corf": "^0.0.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.2.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
