### Authentication ###

# Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "user1",
  "password": "password123",
  "email": "user@gmail.com"
}

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "user1",
  "password": "newpassword123"
}

### Get Profile
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{authToken}}

### Change Password
PUT {{baseUrl}}/auth/change-password
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "currentPassword": "password123",
  "newPassword": "newpassword123"
}

### Forgot Password
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "user@gmail.com",
  "username": "user1"
}

### Users ###

### Get all users (Admin only)
GET {{baseUrl}}/users
Authorization: Bearer {{authToken}}

### Get user by ID
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{authToken}}

### Update user
PUT {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "full_name": "1241241",
  "phone": "0987654321",
  "email": "test@example.com"
}

### Delete user
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{authToken}}

### Deactivate user
PATCH {{baseUrl}}/users/{{userId}}/deactivate
Authorization: Bearer {{authToken}}

### Categories ###

### Get all categories
GET {{baseUrl}}/categories

### Get category by ID
GET {{baseUrl}}/categories/{{categoryId}}

### Create category (Admin only)
POST {{baseUrl}}/categories
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "New Category",
  "description": "Description for new category",
  "status": "active"
}

### Update category (Admin only)
PUT {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Updated Category",
  "description": "Updated description"
}

### Delete category (Admin only)
DELETE {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{authToken}}

### Products ###

### Get all products
GET {{baseUrl}}/products

?page=1
&limit=10
&sort=price
&order=asc

### Get product by ID
GET {{baseUrl}}/products/{{productId}}

### Create product (Admin only)
POST {{baseUrl}}/products
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Test Product",
  "description": "Test Description",
  "original_price": 120000,
  "price": 100000,
  "in_stock": 100,
  "category_id": "{{categoryId}}",
  "images": ["image1.jpg", "image2.jpg"]
}

### Update product (Admin only)
PUT {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Updated Product",
  "price": 150000,
  "in_stock": 80
}

### Delete product (Admin only)
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{authToken}}

### Deactivate product (Admin only)
PATCH {{baseUrl}}/products/6862d1c32df5d5159cc51f08/activate
Authorization: Bearer {{authToken}}

### Deactivate product (Admin only)
PATCH {{baseUrl}}/products/6862d1c32df5d5159cc51f08/deactivate
Authorization: Bearer {{authToken}}

### Search products
GET {{baseUrl}}/products/search?q=mì&page=1&limit=10

### Get products by category
GET {{baseUrl}}/products/category/{{categoryId}}?page=1&limit=10

### Get top rated products
GET {{baseUrl}}/products/top-rated?limit=10

### Get new arrivals
GET {{baseUrl}}/products/new-arrivals?limit=10

### Get related products
GET {{baseUrl}}/products/{{productId}}/related?limit=4
### Orders ###
### Orders ###

### Get all orders (Admin)
GET {{baseUrl}}/orders
Authorization: Bearer {{authToken}}

### Get order by ID (Admin)
GET {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{authToken}}

### Create order (User)
POST {{baseUrl}}/orders
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "address": "Số 123, Quận ABC, TP XYZ",
  "receiver": "Nguyễn Văn AAAAAA",
  "sdt": "0123456789",
  "items": [
    {
      "product_id": "6862d1c32df5d5159cc51ef9",
      "qty": 2
    }
  ],
  "payment_method": "cod",
  "note": "Vui lòng giao buổi sáng"
}

### Get my orders (User)
GET {{baseUrl}}/orders/my?page=1&limit=3
Authorization: Bearer {{authToken}}

### Update order status (Admin)
PUT {{baseUrl}}/orders/{{orderId}}/status
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "status": "processing"
}

### Get order stats (Admin)
GET {{baseUrl}}/orders/stats
Authorization: Bearer {{authToken}}

### Update VNPAY info for order (admin/debug)
PUT {{baseUrl}}/orders/{{orderId}}/vnpay-info
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "order_status": "cancelled",
  "vnpay_txn_ref": "31152240",
  "vnpay_response_code": "24",
  "vnpay_transaction_status": "02",
  "vnpay_error_message": "Giao dịch không thành công do: Khách hàng hủy giao dịch"
}

### Get recent orders (Admin)
GET {{baseUrl}}/orders/recent?limit=10
Authorization: Bearer {{authToken}}

### Delete order (Admin)
DELETE {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{authToken}}

### Addresses ###

### Get all addresses
GET {{baseUrl}}/addresses
