GET {{baseUrl}}/addresses/{{addressId}}
Authorization: Bearer {{authToken}}

### Create address
POST {{baseUrl}}/addresses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "phone": "0123456789",
  "city": "City",
  "district": "District",
  "ward": "Ward",
  "address_detail": "Building A, Room 101",
  "receiver": "Nguyen Van A",
  "is_default": true
}

### Update address
PUT {{baseUrl}}/addresses/{{addressId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "address": "456 New Street"
}

### Delete address
DELETE {{baseUrl}}/addresses/684694371aaf49d7a7259201
Authorization: Bearer {{authToken}}

### Reviews ###

### Get all reviews
GET {{baseUrl}}/reviews
Authorization: Bearer {{authToken}}

### Get review by ID
GET {{baseUrl}}/reviews/{{reviewId}}
Authorization: Bearer {{authToken}}

### Create review
POST {{baseUrl}}/reviews
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "product_id": "{{productId}}",
  "rating": 5,
  "content": "Great product!"
}

### Get product reviews
GET {{baseUrl}}/products/{{productId}}/reviews
?page=1
&limit=10
Authorization: Bearer {{authToken}}


