### Cart ###
### Get cart
GET {{baseUrl}}/carts
Authorization: Bearer {{authToken}}

### Add item to cart
POST {{baseUrl}}/carts/items
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "product_id": "6862d1c32df5d5159cc51ef9",

  "qty": 2
}

### Update cart item
PUT {{baseUrl}}/carts/items/{{productId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "qty": 3
}

### Remove item from cart
DELETE {{baseUrl}}/carts/items/{{productId}}
Authorization: Bearer {{authToken}}

### Clear cart
DELETE {{baseUrl}}/carts/items
Authorization: Bearer {{authToken}}

### Calculate cart total
GET {{baseUrl}}/carts/total
Authorization: Bearer {{authToken}}

### Vouchers ###

### Get all vouchers
GET {{baseUrl}}/vouchers
Authorization: Bearer {{authToken}}


### Get voucher by ID
GET {{baseUrl}}/vouchers/{{voucherId}}

### Create voucher (Admin only)
POST {{baseUrl}}/vouchers
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "code": "NEWVOUCHER",
  "discount_type": "percentage",
  "discount_value": 15,
  "max_discount": 100000,
  "min_order_value": 300000,
  "start_date": "2024-03-20",
  "end_date": "2024-04-20",
  "status": "active"
}

### Update voucher (Admin only)
PUT {{baseUrl}}/vouchers/{{voucherId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "discount_value": 20,
  "max_discount": 150000
}

### Delete voucher (Admin only)
DELETE {{baseUrl}}/vouchers/{{voucherId}}
Authorization: Bearer {{authToken}}

### Get active vouchers
GET {{baseUrl}}/vouchers/active
Authorization: Bearer {{authToken}}

### Apply voucher
POST {{baseUrl}}/vouchers/apply
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "code": "SUMMER2024",
  "total_amount": 1000000
}

### Get voucher stats (Admin only)
GET {{baseUrl}}/vouchers/stats
Authorization: Bearer {{authToken}} 


### Payment - Create VNPAY payment URL
POST {{baseUrl}}/payment/create
Content-Type: application/json

{
  "method": "vnpay",
  "amount": 100000,
  "bankCode": "",
  "language": "vn"
}

### Payment - Handle return from VNPAY
GET {{baseUrl}}/payment/return?method=vnpay&vnp_TxnRef=...&vnp_Amount=...&vnp_ResponseCode=...&vnp_SecureHash=...

### Payment - Handle IPN from VNPAY
GET {{baseUrl}}/payment/ipn?method=vnpay&vnp_TxnRef=...&vnp_Amount=...&vnp_ResponseCode=...&vnp_SecureHash=...

### Payment - Query transaction
POST {{baseUrl}}/payment/query
Content-Type: application/json

{
  "method": "vnpay",
  "orderId": "...",
  "transDate": "...",
  "ipAddr": "..."
}

### Payment - Refund transaction
POST {{baseUrl}}/payment/refund
Content-Type: application/json

{
  "method": "vnpay",
  "orderId": "...",
  "transDate": "...",
  "amount": 100000,
  "transType": "...",
  "user": "...",
  "ipAddr": "..."
} 

